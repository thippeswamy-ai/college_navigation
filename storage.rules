rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isImageFile() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 15 * 1024 * 1024; // Limit to 15MB
    }

    // Public can view all navigation and department images
    match /navigation/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImageFile();
      allow delete: if isAuthenticated();
    }

    match /departments/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImageFile();
      allow delete: if isAuthenticated();
    }

    match /college-info/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImageFile();
      allow delete: if isAuthenticated();
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImageFile();
    }
  }
}
